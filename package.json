{
  "name": "cgm-diabetes-manager-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite --mode personal",
    "dev:personal": "vite --mode personal",
    "dev:portfolio": "vite --mode portfolio",
    "build": "npm run typecheck && vite build --mode personal",
    "build:personal": "npm run typecheck && vite build --mode personal",
    "build:portfolio": "npm run typecheck && vite build --mode portfolio",
    "build:vite:personal": "vite build --mode personal",
    "build:vite:portfolio": "vite build --mode portfolio",
    "preview": "vite preview",
    "typecheck": "node scripts/run-typecheck.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test": "vitest run src scripts",
    "test:watch": "vitest src scripts",
    "test:docs": "node scripts/verify-docs-sync.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:regression": "playwright test --project=portfolio --grep @regression && playwright test --project=personal --grep @regression",
    "test:visual": "playwright test e2e/visual-design.spec.ts --project=portfolio",
    "verify:all": "npm run test:docs && npm run typecheck && npm test && npm run test:smoke && npm run build:vite:personal",
    "pipeline:verify": "node scripts/orchestrate-pipeline.mjs",
    "pipeline:verify:quick": "node scripts/orchestrate-pipeline.mjs --quick",
    "pipeline:ship": "node scripts/orchestrate-pipeline.mjs --ship",
    "pipeline:ship:personal": "node scripts/orchestrate-pipeline.mjs --ship --target=personal",
    "pipeline:ship:demo": "node scripts/orchestrate-pipeline.mjs --ship --target=demo",
    "demo:rebuild-branch": "node scripts/rebuild-demo-branch.mjs",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
